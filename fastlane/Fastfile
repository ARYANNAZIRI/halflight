# Halflight release lanes. Auth is an App Store Connect API key (no Apple ID session):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64 (the .p8 file, base64-encoded)
#   APPLE_TEAM_ID (10-character Team ID)
default_platform(:ios)

platform :ios do
  desc "Regenerate the Xcode project"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "Run unit tests on a simulator"
  lane :test do
    generate
    run_tests(
      project: "Halflight.xcodeproj",
      scheme: "Halflight",
      devices: ["iPhone 17"],
      only_testing: ["HalflightTests"]
    )
  end

  private_lane :asc_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Archive with automatic cloud signing and upload to TestFlight"
  lane :beta do
    generate
    api_key = asc_key
    build_number = ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
    increment_build_number(build_number: build_number, xcodeproj: "Halflight.xcodeproj")

    build_app(
      project: "Halflight.xcodeproj",
      scheme: "Halflight",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        uploadSymbols: true
      },
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Automatic",
      output_directory: "build",
      output_name: "Halflight.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Halflight.ipa",
      skip_waiting_for_build_processing: true,
      changelog: File.read("metadata/en-US/release_notes.txt")
    )
  end

  desc "Push the App Store listing text (no binary) from fastlane/metadata"
  lane :metadata do
    api_key = asc_key
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end
end
